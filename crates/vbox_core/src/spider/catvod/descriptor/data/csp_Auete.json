          "field": "year",
          "label": "◎上映年份"
        }
      ],
      "groups": {
        "tabs": "div.card-header b",
        "lists": "ul.episode-list",
        "item": "a",
        "url_attr": "href"
      },
      "require": [
        {
          "target": "name",
          "error": "详情页缺少标题（站点改版或非 Auete 模板？）"
        }
      ],
      "family_fallback": true
    },
    "search": {
      "path": "/auete4so.php",
