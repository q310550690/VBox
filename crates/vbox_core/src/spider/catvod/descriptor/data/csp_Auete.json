            "sel": [
              "div.media-body a"
            ],
            "collapse": true,
            "non_empty": true
          }
        },
        "cover": {
          "sel": [
            "img"
          ],
          "attr": "src",
          "join_base": true,
          "non_empty": true,
          "fallback": {
            "sel": [
