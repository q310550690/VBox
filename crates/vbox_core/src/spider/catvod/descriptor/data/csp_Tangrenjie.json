  "base": {
    "default": "https://www.tangrenjie.net",
    "ext": "token"
  },
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "zh-CN,zh;q=0.8,zh-TW;q=0.7,zh-HK;q=0.5,en-US;q=0.3,en;q=0.2"
  },
  "retries": 2,
  "endpoints": {
    "categories": {
      "path": "/",
      "rows": [
        "#nav li a"
      ],
      "fields": {
        "id": {
          "self": true,
          "attr": "href",
          "replace": {
            ".html": ""
          },
          "split_on": "/",
          "segment": 2,
          "trim": true,
          "non_empty": true
        },
        "name": {
          "self": true,
          "collapse": true,
          "non_empty": true
        }
      },
      "filters": [
        {
          "field": "name",
          "equals": "网站首页"
        },
        {
          "field": "name",
          "equals": "专题"
        },
        {
          "field": "name",
          "equals": "会员"
        }
      ],
      "dedupe": true
    },
    "list": {
      "family_fallback": true,
      "path": "/type/{cat}.html",
      "segments": [
        {
          "template": "/show/{cat}--------{page}---.html",
          "if_gt": {
            "var": "page",
            "value": 1
          }
        }
      ],
      "rows": [
        "ul.img-list li"
      ],
      "fields": {
        "id": {
          "sel": [
            "a"
          ],
          "attr": "href",
          "trim": true,
          "non_empty": true
        },
        "name": {
          "sel": [
            "a"
          ],
          "attr": "title",
          "trim": true,
          "collapse": true,
          "non_empty": true,
          "fallback": {
            "sel": [
              "h2"
            ],
            "collapse": true,
            "non_empty": true
          }
        },
        "cover": {
          "sel": [
            "img"
          ],
          "attr": "src",
          "trim": true,
          "non_empty": true,
          "fallback": {
            "sel": [
              "img"
            ],
            "attr": "data-original",
            "trim": true,
            "non_empty": true
          }
        },
        "remark": {
          "sel": [
            "i"
          ],
          "collapse": true,
          "non_empty": true
        }
      },
      "filters": [
        {
          "field": "id",
          "if_empty": true
        },
        {
          "field": "id",
          "contains": "/vod/"
        },
        {
          "field": "name",
          "if_empty": true
        }
      ]
    },
    "detail": {
      "family_fallback": true,
      "path": "{id}",
      "rules": [
        {
          "prefixes": [
            "http://",
            "https://"
          ],
          "url": "{id}"
        }
      ],
      "trim_id": true,
      "empty_id_error": "详情 id 为空",
      "fields": {
        "name": {
          "sel": [
            "div.detail-title h1",
            "h1"
          ],
          "collapse": true,
          "non_empty": true
        },
        "cover": {
          "sel": [
            "div.detail-pic img"
          ],
          "attr": "src",
          "trim": true,
          "non_empty": true,
          "fallback": {
            "sel": [
              "div.detail-pic img"
            ],
            "attr": "data-original",
            "trim": true,
            "non_empty": true
          }
        },
        "desc": {
          "sel": [
            "div.vod-intro"
          ],
          "collapse": true,
          "non_empty": true
        }
      },
      "meta_scope": "div.detail-info dl",
      "meta": [
        {
          "field": "year",
          "label": "年份"
        },
        {
          "field": "area",
          "label": "地区"
        },
        {
          "field": "director",
          "label": "导演"
        },
        {
          "field": "actor",
          "label": "主演"
        },
        {
          "field": "actor",
          "label": "演员"
        }
      ],
      "groups": {
        "tabs": "div.box[id^=\"playlist_\"] .box-title h2",
        "lists": "div.box[id^=\"playlist_\"] .video_list",
        "item": "a",
        "url_attr": "href"
      },
      "require": [
        {
          "target": "name",
          "error": "详情页缺少 `div.detail-title h1`（站点改版或非 Tangrenjie 模板？）"
        }
      ]
    },
    "search": {
      "path": "/search/{kw:alnum}----------1---.html",
      "trim_keyword": true,
      "rows": [
        "ul.show-list li"
      ],
      "fields": {
        "id": {
          "sel": [
            "h2 a"
          ],
          "attr": "href",
          "trim": true,
          "non_empty": true
        },
        "name": {
          "sel": [
            "h2 a"
          ],
          "collapse": true,
          "non_empty": true
        },
        "cover": {
          "sel": [
            "a.play-img img"
          ],
          "attr": "src",
          "trim": true,
          "non_empty": true,
          "fallback": {
            "sel": [
              "a.play-img img"
            ],
            "attr": "data-original",
            "trim": true,
            "non_empty": true
          }
        },
        "remark": {
          "sel": [
            "div.play-txt dl:last-of-type dd"
          ],
          "collapse": true,
          "non_empty": true
        }
      },
      "filters": [
        {
          "field": "id",
          "if_empty": true
        },
        {
          "field": "id",
          "contains": "/vod/"
        },
        {
          "field": "name",
          "if_empty": true
        }
      ]
    },
    "play": {
      "family_fallback": true,
      "empty_id_error": "播放 id 为空",
      "parse": 0,
      "jx": true,
      "rules": [
        {
          "prefixes": [
            "http://",
            "https://"
          ],
          "url": "{id}"
        }
      ],
      "url": "{base}{id}",
      "header": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
      }
    }
  }
}
