    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "element-plus": "^2.14.7",
    "pinia": "^2.2.0",
    "vue": "^3.5.44",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "sass": "^1.106.1",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.0.0"
  }
